# Copy to .env.local for local dev, or run `vercel env pull` to get your
# project's real values. Never commit .env.local.

# --- Auth.js ---------------------------------------------------------------

# Encrypts session cookies. Required in production.
# Make one with `npx auth secret` or `openssl rand -base64 33`.
# Local dev works without it (a fixed dev-only secret is used).
AUTH_SECRET=

# Optional. GitHub sign-in turns on when both are set.
# Create an OAuth app at https://github.com/settings/applications/new
# Callback URL: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional. Demo sign-in (no password) is on until GitHub is set up.
# "false" turns it off, "true" keeps it on next to GitHub.
AUTH_DEMO_SIGN_IN=

# --- Customer.io (written by the Customer.io Vercel integration) ------------

# Track API site ID and key. Used to identify people and send events.
CUSTOMERIO_SITE_ID=
CUSTOMERIO_TRACK_API_KEY=

# App API key, send-only. Used for the welcome email (Transactional API).
# The integration adds it to Production and Preview only, so it is usually
# missing in local dev. That is expected: the email step is skipped.
CUSTOMERIO_APP_API_KEY=

# Your workspace ID. Used to link the dashboard to Customer.io.
CUSTOMERIO_WORKSPACE_ID=

# "us" or "eu". Must match the region of your workspace.
CUSTOMERIO_REGION=us

# --- Customer.io (you add these) --------------------------------------------

# Sender of the inline welcome email. Must use a domain you verified in
# Customer.io. Either "hello@example.com" or "Example <hello@example.com>".
CUSTOMERIO_FROM_EMAIL=

# Optional. The ID of a transactional message you designed in Customer.io.
# When set, it is sent instead of the inline email, and CUSTOMERIO_FROM_EMAIL
# is not needed.
CUSTOMERIO_WELCOME_MESSAGE_ID=
