# Copy to .env.local for local dev, or run `vercel env pull` to get your
# project's real values. Never commit .env.local.

# --- You ---------------------------------------------------------------------

# Signs Auth.js cookies and hashes sign-in tokens. Required in production.
# Make one with `npx auth secret` or `openssl rand -base64 33`.
# Local dev works without it (a fixed dev-only secret is used).
AUTH_SECRET=

# --- Neon (written by the Neon integration on Vercel) ------------------------

# Pooled connection, used by the app.
DATABASE_URL=postgres://postgres:acme@localhost:5432/postgres
# Direct connection, used by migrations (`pnpm db:migrate`, and before every build).
DATABASE_URL_UNPOOLED=postgres://postgres:acme@localhost:5432/postgres

# --- Customer.io (written by the Customer.io integration on Vercel) ----------

# Track API site ID and key: identify people and record events. The site ID
# also turns on in-app messages in the browser.
CUSTOMERIO_SITE_ID=
CUSTOMERIO_TRACK_API_KEY=

# App API key, send only: the sign-in link, welcome, and owner emails.
# The integration adds it to Production and Preview only, so it is usually
# missing in local dev. That is expected: sign-in links print in the terminal.
CUSTOMERIO_APP_API_KEY=

# Your workspace ID. Links the status page to Customer.io.
CUSTOMERIO_WORKSPACE_ID=

# "us" or "eu". Must match the region of your workspace.
CUSTOMERIO_REGION=us

# Browser SDK write key. Public by design. Turns on page views, in-app
# messages, and the inbox. Not written for EU workspaces yet.
CUSTOMERIO_CDP_WRITE_KEY=

# --- Customer.io (optional, you add these) -----------------------------------

# Sender of the built-in emails, on a domain you verified in Customer.io.
# "hello@example.com" or "Acme <hello@example.com>". Without it, Customer.io
# uses your verified domain's default sender.
CUSTOMERIO_FROM_EMAIL=

# The owner: the only person who can open /status (setup checklist, "Check
# again"). Also gets an email for each new signup. Local dev without it lets
# any signed-in person open /status.
OWNER_EMAIL=

# IDs of transactional messages you designed in Customer.io. When set, they are
# sent instead of the built-in emails, with message_data:
#   sign-in: url, app_name, expires_in_minutes
#   welcome: app_name, dashboard_url
CUSTOMERIO_MAGIC_LINK_MESSAGE_ID=
CUSTOMERIO_WELCOME_MESSAGE_ID=
